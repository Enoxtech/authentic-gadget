# Backend Auth + Data
# Local development can use any Postgres URL. Production should use Supabase Postgres.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SOURCE_DATABASE_URL=postgresql://postgres:password@old-railway-host:5432/railway
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
RESEND_API_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM=Authentic Gadget <noreply@authenticgad.com>
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Flutterwave (MTN MoMo)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-XXXXXXXXXXXXXXXXXXXXX
FLUTTERWAVE_SECRET_KEY=FLWSECK-XXXXXXXXXXXXXXXXXXXXX
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_flutterwave_webhook_secret_hash

# Cloudflare R2 image uploads
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_BUCKET=authgadget
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-public-bucket.r2.dev
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin
ADMIN_PASSWORD=YourSecureAdminPassword2026
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret
