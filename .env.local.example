# Backend Auth + Data
# Local development can use any Postgres URL. Production should use Supabase Postgres.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SOURCE_DATABASE_URL=postgresql://postgres:password@old-railway-host:5432/railway
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
RESEND_API_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM=Authentic Gadget <noreply@authenticgad.com>
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Flutterwave (MTN MoMo)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-XXXXXXXXXXXXXXXXXXXXX
FLUTTERWAVE_SECRET_KEY=FLWSECK-XXXXXXXXXXXXXXXXXXXXX
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_flutterwave_webhook_secret_hash

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin
ADMIN_PASSWORD=YourSecureAdminPassword2026
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret
