# Supabase Postgres (backend database)
# Use the Supabase pooler/session connection string for Railway if direct IPv6 is unavailable.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:5432/postgres

# Optional one-time data copy source when moving rows from Railway to Supabase.
SOURCE_DATABASE_URL=postgresql://postgres:password@old-railway-host:5432/railway

# Vercel frontend API proxy
RAILWAY_BACKEND_URL=https://your-service.up.railway.app

# Backend Auth
BETTER_AUTH_URL=https://authenticgad.com
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
RESEND_API_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM=Authentic Gadget <noreply@authenticgad.com>
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_placeholder

# Flutterwave (MTN MoMo)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-XXXXXXXXXXXXXXXXXXXXX
FLUTTERWAVE_SECRET_KEY=FLWSECK-XXXXXXXXXXXXXXXXXXXXX
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_flutterwave_webhook_secret_hash

# Base URL
NEXT_PUBLIC_BASE_URL=https://authentic-gadget.vercel.app

# Admin
ADMIN_PASSWORD=devpassword123
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret
