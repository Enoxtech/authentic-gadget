# Supabase Postgres (backend database)
# Use the Supabase pooler/session connection string for Railway if direct IPv6 is unavailable.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:5432/postgres

# Optional one-time data copy source when moving rows from Railway to Supabase.
SOURCE_DATABASE_URL=postgresql://postgres:password@old-railway-host:5432/railway

# Vercel frontend API proxy
RAILWAY_BACKEND_URL=https://your-service.up.railway.app

# Backend Auth
BETTER_AUTH_URL=https://authenticgad.com
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Authentic Gadget <noreply@authenticgad.com>
AUTH_EMAIL_FROM=Authentic Gadget <noreply@authenticgad.com>
ADMIN_EMAIL=orders@authenticgad.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_placeholder

# Hubtel (Ghana MoMo across MTN, Telecel/Vodafone Cash, AirtelTigo)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_REQUEST_MONEY_BASE_URL=https://devp-reqsendmoney-230622-api.hubtel.com/v1
HUBTEL_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

# Flutterwave (legacy Ghana MoMo fallback)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-XXXXXXXXXXXXXXXXXXXXX
FLUTTERWAVE_SECRET_KEY=FLWSECK-XXXXXXXXXXXXXXXXXXXXX
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_flutterwave_webhook_secret_hash

# Manual bank transfer fallback if database settings are unavailable
BANK_TRANSFER_ENABLED=false
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_TRANSFER_NOTE=

# Cloudflare R2 image uploads
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_BUCKET=authgadget
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-public-bucket.r2.dev
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Base URL
NEXT_PUBLIC_BASE_URL=https://authentic-gadget.vercel.app

# Admin
ADMIN_PASSWORD=devpassword123
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret
